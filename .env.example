PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# Storage: sqlite (default) or supabase. Defaults to supabase when SUPABASE_URL is set.
DB_DRIVER=sqlite
DATABASE_FILE=data/watchlist.db

# Supabase (server-side only — never expose the service_role key to the browser)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# OMDb search (server-side only)
OMDB_API_KEY=
